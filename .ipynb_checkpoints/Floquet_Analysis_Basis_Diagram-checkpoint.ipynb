    "plt.plot(t[6000:8000]*beta/(2*np.pi)-t[6000]*beta/(2*np.pi),w[6000:8000]*b[6000:8000]*Ri/ke[6000:8000],c=\"r\",label=r\"$BFLUX_z/k$\")\n",
    "plt.plot(t[6000:8000]*beta/(2*np.pi)-t[6000]*beta/(2*np.pi),(alpha*u[6000:8000]*b[6000:8000]+w[6000:8000]*b[6000:8000]*Ri)/ke[6000:8000],c=\"k\",label=r\"$BFLUX/k$\")\n",
