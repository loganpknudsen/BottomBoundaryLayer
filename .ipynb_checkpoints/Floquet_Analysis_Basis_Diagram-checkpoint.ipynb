{
 "cells": [
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "59e5fc3f",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import scipy.integrate as sc\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "156c0cc0",
   "metadata": {},
   "outputs": [],
   "source": [
    "S = 1.85\n",
    "Ri_inv = 0.85\n",
    "delta = 0.8\n",
    "N2 = S**2*1e-8/1e-2\n",
    "gm = (1+(1-Ri_inv**(-1))*S**2)/(1+S**2)\n",
    "theta = 0.1 \n",
    "f = 1e-4\n",
    "phi = np.pi/2\n",
    "beta = (1+S**2)**(0.5)\n",
    "fstar = f*beta\n",
    "lmbd = N2*gm*theta/f"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b381e377",
   "metadata": {},
   "outputs": [],
   "source": [
    "def m_t(t,m):\n",
    "    return m+delta*lmbd/(fstar)*np.sin(t+phi)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0ce869d5",
   "metadata": {},
   "outputs": [],
   "source": [
    "def PSI_system(v,t,m):\n",
    "    psi, D = v\n",
    "    A0 = -S**2/(theta*(1+S**2))*(m+(1-gm)/theta)\n",
    "    A1 = m+(S**2)*(theta*(1+S**2))**(-1)\n",
    "    dpsidt = (A0-A1*m_t(t,m))*D \n",
    "    dDdt = (1+m_t(t,m)**2)**(-1)*psi \n",
    "    return [dpsidt, dDdt]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "49d925c6",
   "metadata": {},
   "outputs": [],
   "source": [
    "t = np.linspace(0,2*np.pi,100)\n",
    "m = 0.5\n",
    "sol1 = sc.odeint(PSI_system,[1,0],t,args=(m,)) "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0b9f1273",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.plot(t*beta/(2*np.pi),sol1[:,0])\n",
    "plt.plot(t*beta/(2*np.pi),sol1[:,1])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d0ae61cf",
   "metadata": {},
   "outputs": [],
   "source": [
    "t = np.linspace(0,2*np.pi,100)\n",
    "m = 1.3\n",
    "sol2 = sc.odeint(PSI_system,[0,1],t,args=(m,)) "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d9439469",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.plot(t*beta/(2*np.pi),sol2[:,0])\n",
    "plt.plot(t*beta/(2*np.pi),sol2[:,1])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4f644747",
   "metadata": {},
   "outputs": [],
   "source": [
    "M = np.array([[sol1[-1,0],sol1[-1,1]],[sol2[-1,0],sol2[-1,1]]])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "619da1ab",
   "metadata": {},
   "outputs": [],
   "source": [
    "np.log(np.linalg.eig(M)[0]+0*1j)/(2*np.pi/beta)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2a5a37f5",
   "metadata": {
    "scrolled": true
   },
   "outputs": [],
   "source": [
    "m = np.linspace(-30,30,500)\n",
    "frequencies = []\n",
    "growth_rates = []\n",
    "tau = 2*np.pi\n",
    "dt = 500\n",
    "for i in m:\n",
    "    t = np.linspace(0,tau+1/dt,dt)\n",
    "    sol1 = sc.odeint(PSI_system,[1,0],t,args=(i,))\n",
    "    sol2 = sc.odeint(PSI_system,[0,1],t,args=(i,)) \n",
    "    M = np.array([[sol1[-1,0],sol1[-1,1]],[sol2[-1,0],sol2[-1,1]]])\n",
    "    eigs = np.log(np.linalg.eig(M)[0]+0*1j)/(tau)\n",
    "    growth_rates.append(eigs.real)\n",
    "    frequencies.append(eigs.imag)\n",
    "frequencies = np.array(frequencies)\n",
    "growth_rates = np.array(growth_rates)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e7e64e6f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# a[1][0,0]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d2c73aa1",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "82350d74",
   "metadata": {},
   "outputs": [],
   "source": [
    "a = np.linalg.eig(M)\n",
    "t = np.linspace(0,5*tau,1000)\n",
    "plt.plot(t/tau,(a[1][0,0]*np.exp(t*eigs[0]+0*1j)+a[1][0,1]*np.exp(t*eigs[1]+0*1j)).real)\n",
    "plt.plot(t/tau,(a[1][1,0]*np.exp(t*eigs[0]+0*1j)+a[1][1,1]*np.exp(t*eigs[1]+0*1j)).real)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e499f159",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.scatter(m,growth_rates[:,0],marker=\".\",color=\"k\")\n",
    "plt.scatter(m,growth_rates[:,1],marker=\".\",color=\"k\")\n",
    "plt.xlabel(\"Vertical Wave Mode\")\n",
    "plt.ylabel(\"Growth Rate\")\n",
    "# plt.yscale(\"symlog\",linthresh=1e-4)\n",
    "# plt.xscale(\"symlog\",linthresh=1e-1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "03737c21",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.scatter(m[:],frequencies[:,0]/beta,marker=\".\",color=\"k\")\n",
    "plt.scatter(m[:],frequencies[:,1]/beta,marker=\".\",color=\"k\")\n",
    "# plt.hlines(0.5,0,3,color=\"k\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2e4349ff",
   "metadata": {},
   "outputs": [],
   "source": [
    "gr = growth_rates[np.argmax(np.abs(growth_rates[:,0])),:]\n",
    "fr = frequencies[np.argmax(np.abs(growth_rates[:,0])),:]\n",
    "m_max = m[np.argmax(np.abs(growth_rates[:,0]))]\n",
    "gr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1a4888f5",
   "metadata": {},
   "outputs": [],
   "source": [
    "0.038991/0.048127"
    "0.031202/0.03964352"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "bb0789a0",
   "metadata": {},
   "outputs": [],
   "source": [
    "0.060722/0.0868397"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "337bad08",
   "metadata": {},
   "outputs": [],
   "source": [
    "H = 0.1/lmbd\n",
    "m_max"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e2d8f68c",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "90710bb3",
   "metadata": {},
   "outputs": [],
   "source": [
    "x = np.linspace(0,2000/H,300)\n",
    "z = np.linspace(0,1,100)\n",
    "X, Z = np.meshgrid(x,z)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ba4644bc",
   "metadata": {},
   "outputs": [],
   "source": [
    "tau = 10*2*np.pi/(beta)\n",
    "k = 1\n",
    "sol = np.exp(-1j*(X-m_t(tau,m_max,k)*(1-Z)))*np.exp(-1j*((gr[0]*1j+fr[0])*tau))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "996b66e6",
   "metadata": {},
   "outputs": [],
   "source": [
    "t = np.linspace(0,tau,10000)\n",
    "sol3 = sc.odeint(PSI_system,[0,1],t,args=(m_max,)) "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c7bc8818",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "570ff680",
   "metadata": {},
   "outputs": [],
   "source": [
    "np.shape(sol3)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fa7b02b1",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.plot(t*beta/(2*np.pi),sol3[:,0],color=\"blue\")\n",
    "plt.plot(t*beta/(2*np.pi),sol3[:,1],color=\"k\")\n",
    "plt.xlabel(\"Inertial Periods\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "80dbdd5e",
   "metadata": {},
   "outputs": [],
   "source": [
    "k = 1\n",
    "w = ((m_t(t,m_max,k))**2+n**2)**(-1)*sol3[:,0]\n",
    "u = -m_t(t,m_max,k)*w\n",
    "v = -1*(1-delta-m_max-n*np.tan(theta))*sol3[:,1]\n",
    "b = -(1-Ri**(-1)*gm**(-1)*m_max)*sol3[:,1]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2209e6a6",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(8,4))\n",
    "plt.plot(t*beta/(2*np.pi),u,c=\"red\",label=r\"$\\tilde{u}(t)$\")\n",
    "plt.plot(t*beta/(2*np.pi),v,c=\"blue\",label=r\"$\\tilde{v}(t)$\")\n",
    "plt.xlim([0,10])\n",
    "plt.xlabel(\"Inertial Period\")\n",
    "plt.yscale(\"symlog\",linthresh=1)\n",
    "plt.legend(loc=\"lower left\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b0386c10",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.plot(t*beta/(2*np.pi),w,c=\"green\",label=r\"$\\tilde{w}(t)$\")\n",
    "plt.plot(t*beta/(2*np.pi),b,c=\"k\",label=r\"$\\tilde{b}(t)$\")\n",
    "plt.xlabel(\"Inertial Period\")\n",
    "plt.yscale(\"symlog\",linthresh=1)\n",
    "plt.legend(loc=\"lower left\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a6b7dd3b",
   "metadata": {
    "scrolled": true
   },
   "outputs": [],
   "source": [
    "# AGSP = -u*w*m_t(t,m_max)*u-v*w*m_t(t,m_max)*v\n",
    "# plt.plot(AGSP)\n",
    "# plt.plot(GSP)\n",
    "# plt.yscale(\"symlog\",linthresh=1e-3)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8a031b55",
   "metadata": {},
   "outputs": [],
   "source": [
    "ke = 0.5*(u**2+v**2+n**2*w**2)\n",
    "dkdt = np.gradient(ke,t[-1]-t[-2])\n",
    "GSP = -v*w\n",
    "WSP = u*w*delta*beta**(-1)*np.sin(beta*t)+v*w*(delta+delta*beta**(-2)*(np.cos(beta*t)-1))\n",
    "BFLUX = alpha*u*b+w*b*Ri\n",
    "error = dkdt-GSP[:]-WSP[:]-BFLUX[:]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cbe84c13",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9e3a93cc",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.plot(t*beta/(2*np.pi),ke)\n",
    "plt.yscale(\"log\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9de4b912",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(8,3))\n",
    "ts = 5000\n",
    "tf = -1\n",
    "plt.plot(t[ts:tf]*beta/(2*np.pi)-t[ts]*beta/(2*np.pi),dkdt[ts:tf]/ke[ts:tf],c=\"k\",label=\"dkdt/k\")\n",
    "plt.plot(t[ts:tf]*beta/(2*np.pi)-t[ts]*beta/(2*np.pi),BFLUX[ts:tf]/ke[ts:tf],c=\"b\",label=\"BFLUX/k\")\n",
    "plt.plot(t[ts:tf]*beta/(2*np.pi)-t[ts]*beta/(2*np.pi),GSP[ts:tf]/ke[ts:tf],c=\"g\",label=\"GSP/k\")\n",
    "plt.plot(t[ts:tf]*beta/(2*np.pi)-t[ts]*beta/(2*np.pi),WSP[ts:tf]/ke[ts:tf],c=\"cyan\",label=\"WSP/k\")\n",
    "plt.plot(t[ts:tf]*beta/(2*np.pi)-t[ts]*beta/(2*np.pi),error[ts:tf]/ke[ts:tf],c=\"k\",linestyle=\"--\",label=\"Residual\")\n",
    "# plt.ylim([-1,1])\n",
    "# plt.xlim([0,4])\n",
    "plt\n",
    "plt.legend(loc=\"lower left\",ncol=5)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "61325a84",
   "metadata": {
    "scrolled": true
   },
   "outputs": [],
   "source": [
    "plt.figure(figsize=(8,6))\n",
    "ts = 0\n",
    "tf = 6000\n",
    "intGSP = sc.cumulative_trapezoid(GSP[:],t[:])\n",
    "intWSP = sc.cumulative_trapezoid(WSP[:],t[:])\n",
    "intBFLUX = sc.cumulative_trapezoid(BFLUX[:],t[:])\n",
    "residual = ke[:-1]-intGSP-intWSP-intBFLUX\n",
    "plt.plot(t[ts:tf:5]*beta/(2*np.pi),intGSP[ts:tf:5],c=\"g\",label=r\"$\\int_0^tGSP\\,dt$\")\n",
    "plt.plot(t[ts:tf:5]*beta/(2*np.pi),intWSP[ts:tf:5],c=\"cyan\",label=r\"$\\int_0^tWSP\\,dt$\")\n",
    "plt.plot(t[ts:tf:5]*beta/(2*np.pi),intBFLUX[ts:tf:5],c=\"b\",label=r\"$\\int_0^tBFLUX\\,dt$\")\n",
    "plt.plot(t[ts:tf:5]*beta/(2*np.pi),ke[ts:tf:5]-ke[0],c=\"k\",label=r\"$k$\")\n",
    "plt.plot(t[ts:tf:5]*beta/(2*np.pi),residual[ts:tf:5]-residual[ts],c=\"r\",label=\"Residual\")\n",
    "plt.yscale(\"symlog\",linthresh=1)\n",
    "plt.xlim([0,6])\n",
    "# plt.ylim([-5e3,5e3])\n",
    "plt.xlabel(\"Inertial Period\")\n",
    "plt.ylabel(\"Energy\")\n",
    "plt.legend(loc=\"upper left\",ncol=2)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f62f8edb",
   "metadata": {},
   "outputs": [],
   "source": [
    "import scipy.stats as st\n",
    "line = st.linregress(t[ts:tf],np.log(ke[ts:tf]/ke[0]))\n",
    "line"
   ]
  },
